{
  "name": "@webinex/antik",
  "description": "Formik bound Ant Design components",
  "private": false,
  "version": "2.0.0-alpha.0",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./add/async-select": {
      "types": "./dist/types/add/async-select/index.d.ts",
      "import": "./dist/add/async-select/index.js",
      "default": "./dist/add/async-select/index.js"
    }
  },
  "sideEffects": [
    "./dist/add/async-select/index.js"
  ],
  "homepage": "https://webinex.github.io/dynamic-form",
  "files": [
    "dist",
    "assets",
    "lib",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "dev": "vite",
    "watch": "vite build --watch",
    "build": "yarn run lint && tsc --noEmit -p tsconfig.lib.json && vite build",
    "gh-pages:build": "tsc -b && vite build -- --gh-pages",
    "gh-pages:deploy": "gh-pages --branch demo -d .gh-pages",
    "lint": "eslint ./lib --ext .ts,.tsx --ignore-pattern ./lib/**/*.d.ts",
    "preview": "vite preview",
    "prepublishOnly": "yarn run build",
    "prettier": "prettier . --write"
  },
  "peerDependencies": {
    "@ant-design/icons": "^6",
    "antd": "^6",
    "classnames": "^2",
    "dayjs": "^1",
    "formik": "^2",
    "react": "^19",
    "react-dom": "^19"
  },
  "devDependencies": {
    "@ant-design/icons": "^6.2.5",
    "@eslint/js": "^9.13.0",
    "@types/node": "^22.7.9",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/yup": "^0.32.0",
    "@vitejs/plugin-react": "^6.0.2",
    "antd": "^6.4.3",
    "classnames": "^2.5.1",
    "dayjs": "^1.11.13",
    "eslint": "^9.13.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.13",
    "formik": "^2.4.6",
    "prettier": "^3.4.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sass-embedded": "^1.82.0",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.10.0",
    "vite": "^8.0.14",
    "vite-plugin-dts": "^5.0.1",
    "vite-plugin-lib-inject-css": "^2.1.1",
    "yup": "^1.7.1"
  }
}
